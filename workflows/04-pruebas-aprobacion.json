      "id": "20ad281c-3c79-46d9-be4c-719d8670f163",
      "name": "Elegir dos productos QA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const data=$input.all().map(i=>i.json).filter(p=>p.fields?.SKU?.startsWith('QA-')&&p.fields?.['Estado del producto']==='Pendiente de aprobación'&&p.fields?.['Título generado']);data.sort((a,b)=>b.createdTime.localeCompare(a.createdTime));const a=data.find(p=>p.fields.SKU.endsWith('TC01'));const b=data.find(p=>p.fields.SKU.endsWith('TC02'));if(!a||!b)throw new Error('Faltan productos QA generados para probar decisiones');return [a,b].map((p,i)=>({json:{...p,decision_prueba:i?'Rechazado':'Aprobado'}}));"
      },
