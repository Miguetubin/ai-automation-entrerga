      "parameters": {
        "jsCode": "const run=Date.now().toString(36).toUpperCase();\nconst cases=[\n {caso:'TC01',nombre:'PRUEBA Soporte de celular para moto',caracteristicas:'Soporte ajustable, fijación al manubrio, rotación de 360 grados'},\n {caso:'TC02',nombre:'PRUEBA Soporte de celular para auto',caracteristicas:'Soporte magnético, fijación a rejilla, rotación de 360 grados'},\n {caso:'TC03',nombre:'PRUEBA Datos incompletos',caracteristicas:''},\n {caso:'TC04',nombre:'PRUEBA Producto fuera de Pendiente',caracteristicas:'Soporte ajustable',estado:'Pendiente de aprobación'},\n {caso:'TC05',nombre:'PRUEBA Fallo controlado de OpenAI',caracteristicas:'Soporte ajustable, fijación al manubrio',fault:true}\n];\nreturn cases.map(c=>({json:{...c,sku:`QA-${run}-${c.caso}`,precio:15000,publico:'Conductores que utilizan el celular como GPS',estado:c.estado??'Pendiente'}}));"
      },
